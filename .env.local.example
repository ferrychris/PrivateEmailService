# Raymail env vars. Copy this to `.env.local` and fill in.

# --- Supabase ---
# From: Supabase dashboard → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Service-role key — bypasses RLS. Used ONLY by the inbound webhook server-side.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Resend ---
# From: https://resend.com/api-keys
RESEND_API_KEY=re_xxx
# From: https://resend.com/webhooks → your webhook → Signing secret
RESEND_WEBHOOK_SECRET=whsec_xxx

# --- Raymail config ---
# Only this email is allowed to sign in.
ALLOWED_EMAIL=
# The "From" address you send as. Must be on a verified Resend sending domain.
FROM_EMAIL=
# Public URL of this app (used to build the magic-link redirect).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Setup checklist ---
# 1. Run the migration: `supabase/migrations/0001_init.sql` against your Supabase project
#    (Supabase dashboard → SQL editor, or via the Supabase CLI).
# 2. Create the user account in Supabase: Authentication → Users → "Add user" →
#    enter ALLOWED_EMAIL and a password you choose. Check "Auto Confirm User"
#    so you don't need to click an email link.
#    Also: Authentication → URL Configuration → add
#    `http://localhost:3000/auth/callback` (and your prod URL) to "Redirect URLs"
#    so the password reset flow works.
# 3. In Resend, verify your sending + receiving domain `mail.raytimedigital.com`
#    (add the MX, DKIM, SPF records to Cloudflare/your DNS).
# 4. In Resend → Webhooks, add a webhook pointing to:
#    https://YOUR-APP-URL/api/webhook/resend
#    Event: email.received. Copy the signing secret into RESEND_WEBHOOK_SECRET above.
# 5. Sign in at /login with the email + password from step 2.
